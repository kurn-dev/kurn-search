  "info": {
    "description": "Canonical external description of kurn-search/service-contract/v1.",
    "title": "Kurn Search API",
    "version": "1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.1.0",
  "paths": {
    "/v1/search/{adapter}": {
      "post": {
        "description": "Refusal precedence: authenticate (401/403) → method (405) → media type (415) → route (404) → body bound/parse (400) → adapter-version pin (409) → trusted scope (403) → preflight (400/504) → admission (503/504) → execution. Physical-list names and stamps in successful responses are opaque provenance, not request inputs or management identifiers.",
        "operationId": "search",
        "parameters": [
          {
            "description": "Stable reviewed adapter route.",
            "in": "path",
            "name": "adapter",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "minimal": {
                  "summary": "Minimal request",
                  "value": {
                    "limit": 25,
                    "query": "AX-104"
                  }
                },
                "pinned": {
                  "summary": "Caller partition and adapter pin",
                  "value": {
                    "adapter_version": "v1",
                    "limit": 25,
                    "partition_id": "partition-neutral",
                    "query": "AX-104"
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "facet_alternatives": {
                    "summary": "Complete self-excluding facet alternatives",
                    "value": {
                      "adapter": {
                        "behavior_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                        "name": "parts-catalog-discover-facet-alternatives",
                        "version": "v1"
                      },
                      "complete": true,
                      "facets": {
                        "category": {
                          "basis_total": 1,
                          "buckets": [
                            {
                              "count": 1,
                              "value": "gasket"
                            }
                          ]
                        },
                        "manufacturer": {
                          "basis_total": 2,
                          "buckets": [
                            {
                              "count": 1,
                              "value": "Northstar"
                            },
                            {
                              "count": 1,
                              "value": "Vega"
                            }
                          ]
                        },
                        "status": {
                          "basis_total": 1,
                          "buckets": [
                            {
                              "count": 1,
                              "value": "active"
                            }
                          ]
                        }
                      },
                      "hits": [
                        {
                          "entry_id": "neutral-1",
                          "result": {
                            "category": "gasket",
                            "id": "neutral-1",
                            "identifier": "AX-104",
                            "manufacturer": "Northstar",
                            "name": "Exhaust gasket",
                            "status": "active",
                            "tenant_id": "tenant-a"
                          }
                        }
                      ],
                      "lists": [
                        {
                          "name": "catalog-v1",
                          "role": "identifiers",
                          "stamp": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb@1+j0+ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
                        }
                      ],
                      "pool": 128,
                      "pool_step": 1,
                      "timing_us": {
                        "backend": 7,
                        "residual": 4,
                        "service": 11
                      },
                      "total_matches": 1,
                      "version_attempt": 1
                    }
                  },
                  "facets": {
                    "summary": "Complete faceted answer",
                    "value": {
                      "adapter": {
                        "behavior_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                        "name": "parts-catalog-discover-facets",
                        "version": "v1"
                      },
                      "complete": true,
                      "facets": {
                        "category": [
                          {
                            "count": 1,
                            "value": "gasket"
                          }
                        ],
                        "manufacturer": [
                          {
                            "count": 1,
                            "value": "Northstar"
                          }
                        ],
                        "status": [
                          {
                            "count": 1,
                            "value": "active"
                          }
                        ]
                      },
                      "hits": [
                        {
                          "entry_id": "neutral-1",
                          "result": {
                            "category": "gasket",
                            "id": "neutral-1",
                            "identifier": "AX-104",
                            "manufacturer": "Northstar",
                            "name": "Exhaust gasket",
                            "status": "active",
                            "tenant_id": "tenant-a"
                          }
                        }
                      ],
                      "lists": [
                        {
                          "name": "catalog-v1",
                          "role": "identifiers",
                          "stamp": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb@1+j0+ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
                        }
                      ],
                      "pool": 128,
                      "pool_step": 1,
                      "timing_us": {
                        "backend": 7,
                        "residual": 4,
                        "service": 11
                      },
                      "total_matches": 1,
                      "version_attempt": 1
                    }
                  },
                  "nonempty": {
                    "summary": "Complete ranked answer",
                    "value": {
                      "adapter": {
                        "behavior_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                        "name": "catalog-identifier",
                        "version": "v1"
                      },
                      "complete": true,
                      "hits": [
                        {
                          "entry_id": "neutral-1",
                          "result": {
                            "label": "AX-104"
                          }
                        }
                      ],
                      "lists": [
                        {
                          "name": "catalog-v1",
                          "role": "identifiers",
                          "stamp": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb@1+j0+ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
                        }
                      ],
                      "pool": 128,
                      "pool_step": 1,
                      "timing_us": {
                        "backend": 7,
                        "residual": 4,
                        "service": 11
                      },
                      "version_attempt": 1
                    }
                  },
                  "zero_hit": {
                    "summary": "Complete zero-hit answer",
                    "value": {
                      "adapter": {
                        "behavior_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                        "name": "catalog-identifier",
                        "version": "v1"
                      },
                      "complete": true,
                      "hits": [],
                      "lists": [
                        {
                          "name": "catalog-v1",
                          "role": "identifiers",
                          "stamp": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb@1+j0+ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
                        }
                      ],
                      "pool": 128,
                      "pool_step": 1,
                      "timing_us": {
                        "backend": 7,
                        "residual": 4,
                        "service": 11
                      },
                      "version_attempt": 1
                    }
                  }
                },
                "schema": {
                  "description": "Ordinary routes return SearchSuccess; parts-catalog-discover-facets returns SearchFacetsSuccess, and parts-catalog-discover-facet-alternatives returns SearchFacetAlternativesSuccess with self-excluding bases.",
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SearchSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/SearchFacetsSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/SearchFacetAlternativesSuccess"
                    }
                  ]
                }
              }
            },
            "description": "Complete answer only; partial answers are never returned.",
            "headers": {
              "Cache-Control": {
