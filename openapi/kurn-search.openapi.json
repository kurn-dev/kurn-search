          "manufacturer",
          "status"
        ],
        "type": "object"
      },
      "FacetBucket": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "description": "Rows in the complete matched set carrying this payload-exact value.",
            "maximum": 999,
            "minimum": 1,
            "type": "integer"
          },
          "value": {
            "description": "Payload-exact source string; at most 512 Unicode scalar values.",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "count",
          "value"
        ],
        "type": "object"
      },
      "FacetBucketList": {
        "description": "Buckets ordered by count descending, then by value in JavaScript UTF-16 code-unit order; each group's counts sum exactly to total_matches.",
        "items": {
          "$ref": "#/components/schemas/FacetBucket"
        },
        "maxItems": 999,
        "minItems": 0,
        "type": "array"
      },
      "Facets": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "$ref": "#/components/schemas/FacetBucketList"
          },
          "manufacturer": {
            "$ref": "#/components/schemas/FacetBucketList"
          },
          "status": {
            "$ref": "#/components/schemas/FacetBucketList"
          }
        },
        "required": [
