          },
          "timing_us": {
            "$ref": "#/components/schemas/TimingUS"
          },
          "version_attempt": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "adapter",
          "complete",
          "hits",
          "lists",
          "pool",
          "pool_step",
          "timing_us",
          "version_attempt"
        ],
        "type": "object"
      },
      "TimingUS": {
        "additionalProperties": false,
        "properties": {
          "backend": {
            "minimum": 0,
            "type": "integer"
          },
          "residual": {
            "minimum": 0,
            "type": "integer"
          },
          "service": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "backend",
          "residual",
          "service"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "Bearer authentication; trusted tenant scope is constructed only by the service.",
        "scheme": "bearer",
        "type": "http"
      }
    }
