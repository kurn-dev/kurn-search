          "manufacturer",
          "status"
        ],
        "type": "object"
      },
      "Hit": {
        "additionalProperties": false,
        "properties": {
          "entry_id": {
            "description": "Opaque entry identity; runtime maximum 512 UTF-8 bytes.",
            "minLength": 1,
            "type": "string"
          },
          "result": {
            "description": "Non-null opaque JSON result. Thin clients map this to unknown or Any.",
            "type": [
              "object",
              "array",
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "required": [
          "entry_id",
          "result"
        ],
        "type": "object"
      },
      "ListProvenance": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Opaque physical-list name returned only as audit provenance.",
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "description": "Reviewed adapter list role.",
            "minLength": 1,
            "type": "string"
          },
          "stamp": {
            "description": "Opaque served list stamp returned only as audit provenance.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "role",
          "stamp"
        ],
        "type": "object"
      },
      "SearchFacetAlternativesSuccess": {
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "$ref": "#/components/schemas/AdapterIdentity"
          },
          "complete": {
            "const": true,
            "type": "boolean"
          },
          "facets": {
            "$ref": "#/components/schemas/FacetAlternatives"
          },
          "hits": {
            "description": "All-filter ranked hit prefix. The group-specific alternative bases precede caller limiting.",
            "items": {
              "$ref": "#/components/schemas/Hit"
            },
            "maxItems": 1000,
            "minItems": 0,
            "type": "array"
          },
          "lists": {
            "items": {
              "$ref": "#/components/schemas/ListProvenance"
            },
            "minItems": 1,
            "type": "array"
          },
          "pool": {
            "minimum": 1,
            "type": "integer"
          },
          "pool_step": {
            "minimum": 1,
            "type": "integer"
          },
          "timing_us": {
            "$ref": "#/components/schemas/TimingUS"
          },
          "total_matches": {
            "description": "Exact all-filter total before the hit limit.",
            "maximum": 999,
            "minimum": 0,
            "type": "integer"
          },
          "version_attempt": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "adapter",
          "complete",
          "facets",
          "hits",
          "lists",
          "pool",
          "pool_step",
          "timing_us",
          "total_matches",
          "version_attempt"
        ],
        "type": "object"
      },
      "SearchFacetsSuccess": {
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "$ref": "#/components/schemas/AdapterIdentity"
          },
          "complete": {
            "const": true,
            "type": "boolean"
          },
          "facets": {
            "$ref": "#/components/schemas/Facets"
          },
          "hits": {
            "description": "Complete hits in adapter-defined ranking order: the prefix of the complete matched set with length min(limit, total_matches).",
            "items": {
              "$ref": "#/components/schemas/Hit"
            },
            "maxItems": 1000,
            "minItems": 0,
            "type": "array"
          },
          "lists": {
            "description": "Opaque provenance in canonical role-then-name order.",
            "items": {
              "$ref": "#/components/schemas/ListProvenance"
            },
            "minItems": 1,
            "type": "array"
          },
          "pool": {
            "minimum": 1,
            "type": "integer"
          },
          "pool_step": {
            "minimum": 1,
            "type": "integer"
          },
          "timing_us": {
            "$ref": "#/components/schemas/TimingUS"
          },
          "total_matches": {
            "description": "Exact size of the complete, trusted, currently filtered matched set before the caller limit is applied.",
            "maximum": 999,
            "minimum": 0,
            "type": "integer"
          },
          "version_attempt": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "adapter",
          "complete",
          "facets",
          "hits",
          "lists",
          "pool",
          "pool_step",
          "timing_us",
          "total_matches",
          "version_attempt"
        ],
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "properties": {
          "adapter_version": {
            "description": "Optional exact adapter-version pin; runtime maximum 32 UTF-8 bytes.",
            "minLength": 1,
            "type": "string"
          },
          "filters": {
            "additionalProperties": false,
            "description": "Optional adapter-dependent literal filters: parts-catalog accepts scalar equality; parts-catalog-select additionally accepts arrays (OR within a field, AND across fields and trusted scope). Omission or {} adds no business restriction; an empty array is invalid. Supplied array counts apply before deduplication. Status vocabulary is adapter-owned; catalog-identifier rejects any present filters member. Values are not trimmed or case-folded; lengths count Unicode scalar values.",
            "properties": {
              "category": {
                "items": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 16,
                "maxLength": 512,
                "minItems": 1,
                "minLength": 1,
                "type": [
                  "string",
                  "array"
                ]
              },
              "manufacturer": {
                "items": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 16,
                "maxLength": 512,
                "minItems": 1,
                "minLength": 1,
                "type": [
                  "string",
                  "array"
                ]
              },
              "status": {
                "items": {
                  "maxLength": 512,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 2,
                "maxLength": 512,
                "minItems": 1,
                "minLength": 1,
                "type": [
                  "string",
                  "array"
                ]
              }
            },
            "required": [],
            "type": "object"
          },
          "limit": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          "partition_id": {
            "description": "Optional caller-controlled partition identity; runtime maximum 4096 UTF-8 bytes.",
            "minLength": 1,
            "type": "string"
          },
          "query": {
            "description": "Search text; length counts Unicode code points.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "limit",
          "query"
        ],
        "type": "object"
      },
      "SearchSuccess": {
        "additionalProperties": false,
        "properties": {
          "adapter": {
            "$ref": "#/components/schemas/AdapterIdentity"
          },
          "complete": {
            "const": true,
            "type": "boolean"
          },
          "hits": {
